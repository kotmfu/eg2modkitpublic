<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Eg2.ModInstaller</RootNamespace>
    <AssemblyName>Eg2ModInstaller</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eg2.ModKit\Eg2.ModKit.csproj" />
    <!-- same Evil Genius 2 look as ModKit -->
    <Compile Include="..\Eg2.ModManager\Theme.cs" Link="Theme.cs" />
    <!-- the same Quick Tweaks rows as ModKit, so the two stay in sync -->
    <Compile Include="..\Eg2.ModManager\TweaksPanel.cs" Link="TweaksPanel.cs" />
    <!-- mods with runtime tweaks install this proxy; see native\winmm -->
    <None Include="..\..\native\winmm\bin\xinput1_4.dll" Link="runtime\xinput1_4.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\winmm\bin\xinput1_4.dll')" />
  </ItemGroup>
</Project>
