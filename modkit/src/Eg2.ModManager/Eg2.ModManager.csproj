<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Eg2.ModManager</RootNamespace>
    <AssemblyName>Eg2ModManager</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eg2.ModKit\Eg2.ModKit.csproj" />
    <!-- prebuilt by native\winmm\build.cmd; kept in runtime\ so ModManager itself never loads it -->
    <None Include="..\..\native\winmm\bin\xinput1_4.dll" Link="runtime\xinput1_4.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\..\native\winmm\bin\xinput1_4.dll')" />
  </ItemGroup>
</Project>
